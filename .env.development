# ============================================================
# 开发模式专用（仅 `npm run dev` 加载）
# ============================================================
# Vite 的加载优先级（低 → 高）：
#   .env  <  .env.local  <  .env.[mode]  <  .env.[mode].local
# 本文件是 .env.[mode]，其中 mode = development（`wxt` 命令的默认 mode），
# 因此它会覆盖根目录 .env 里的同名键。生产构建（`wxt build` / `wxt zip`）
# 的 mode 是 production，不会读本文件。
#
# 目的：开发期把后端从生产 http://43.99.86.228:5724 切到本地，
# 避免调试动作（注册消耗真实邀请码、改写 trialUsed/trialEnabled、
# 污染埋点数据）落进生产库。

VITE_BACKEND_URL=http://localhost:5724

# 必须留空 —— 不要在这里填生产 IP。
# 该值被 tryBackendFetch()（entrypoints/background.ts:9）与
# tryFetch()（entrypoints/popup/backend-api.ts:10）用作"主地址请求失败后的
# 静默回落地址"。若填了生产 IP，本地后端一停就会悄悄把请求打到生产库，
# 恰好是本次要避免的情况。
VITE_BACKEND_FALLBACK_URL=

# 未设置 VITE_DEBUG_LOGS：与根 .env 的现状保持一致（等同于 false）。
# 开启它会让 dev 构建多输出诊断日志，属于本任务范围之外的行为变更。
# 需要时自行取消下面这行注释：
# VITE_DEBUG_LOGS=true
